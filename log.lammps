# UNIAXIAL TENSILE DEFORMATION OF Fe-Cu SYSTEM
# ==============================================================================

# 1. INITIALIZATION
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# 2. LATTICE & GEOMETRY SETUP (BCC Iron)
lattice         bcc 2.855
